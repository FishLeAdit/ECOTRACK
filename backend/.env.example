# Copy this file to .env for local development. Never commit the real .env.
# On Render, set these in the service's Environment tab instead.

# MongoDB connection string (local, or an Atlas mongodb+srv:// URI).
# Include the database name before the "?", e.g. .../ecotrack?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/ecotrack

# Secret used to sign login tokens. REQUIRED in production (the server refuses to start
# without it when NODE_ENV=production). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Allowed frontend origin(s) for CORS, comma-separated, no trailing slash.
# Leave empty in local development to allow any origin.
FRONTEND_URL=

# Set to "production" when deployed
NODE_ENV=development

# Port to listen on (Render sets this automatically)
PORT=5000

# How often the shared demo account is wiped and re-seeded, in hours (default 6)
DEMO_RESET_HOURS=6
